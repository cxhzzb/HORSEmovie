{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Qwen-Image 2.1 UNET" },
    "inputs": {
      "unet_name": "qwen-image-2.1-UC-int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3-VL 8B text encoder" },
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Qwen-Image 2.1 VAE" },
    "inputs": { "vae_name": "qwen_image_2.1_vae_bf16.safetensors" }
  },
  "4": {
    "class_type": "TextEncodeQwenImage21",
    "_meta": { "title": "prompt" },
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "cinematic still, a lone cultivator in dark robes standing on a broken orbital elevator, dusk, volumetric light, film grain",
      "negative_prompt": "",
      "resolution": 1024,
      "images": {}
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "size" },
    "inputs": { "width": 768, "height": 432, "batch_size": 1 }
  },
  "6": {
    "class_type": "KSampler",
    "_meta": { "title": "sampler" },
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["4", 1],
      "latent_image": ["5", 0],
      "seed": 42,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "_meta": { "title": "decode" },
    "inputs": { "samples": ["6", 0], "vae": ["3", 0] }
  },
  "8": {
    "class_type": "SaveImage",
    "_meta": { "title": "save" },
    "inputs": { "images": ["7", 0], "filename_prefix": "dsh/qwen-txt2img" }
  }
}
