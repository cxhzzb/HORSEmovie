# 这个仓库要同时服务 Linux 与 Windows，行尾必须固定，否则 Windows 上
# core.autocrlf=true 会把 .py/.js/.yml 转成 CRLF，拿到 Linux 上就跑不了
# （bash 脚本会报 `bad interpreter: /usr/bin/env python3\r`）。
* text=auto eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp4 binary
*.safetensors binary
*.gguf binary

# 显式声明（防止上面规则被覆盖）
*.py   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.txt  text eol=lf
